# supabase (service key stays on the server, never in the browser)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# direct Postgres connection, used for transactional log appends
DATABASE_URL=

# chain (Base Sepolia)
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
RELAYER_PRIVATE_KEY=
HUB_ADDRESS=
SEMAPHORE_ADDRESS=0x8A1fd199516489B0Fb7153EB5f075cDAC83c693D

# receipts are signed with this P-256 key (PKCS8, base64); public key is served on /api/meta
LOG_SIGNING_KEY=
# base for per-conversation Anon Aadhaar nullifier seeds
APP_NULLIFIER_SEED=
# test | production
AADHAAR_MODE=test

# AI summary (any OpenAI-compatible endpoint)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# server
PORT=4000
WEB_ORIGIN=http://localhost:3000

# web (public)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# scales every rate limit (e.g. 5 for a large event behind one campus IP)
RATE_LIMIT_MULTIPLIER=1
